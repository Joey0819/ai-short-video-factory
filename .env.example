# Local secrets stay in .env.local. Do not commit real API keys.
OPENAI_API_KEY=
CHATGPT_ACCOUNT_VERIFIED=false
CHATGPT_APP_REGISTERED=false

# Development uses the local OAuth issuer. For production ChatGPT Apps / MCP,
# configure a managed OAuth/OIDC provider and JWKS verifier.
HOST=0.0.0.0
PORT=3030
CHATGPT_OAUTH_ISSUER=
CHATGPT_OAUTH_JWKS_URI=
CHATGPT_OAUTH_AUTHORIZE_URL=
CHATGPT_OAUTH_TOKEN_URL=
CHATGPT_OAUTH_REGISTER_URL=
CHATGPT_OAUTH_METADATA_URL=
CHATGPT_OAUTH_AUDIENCE=
PUBLIC_MCP_ORIGIN=

# Optional future adapters for image-to-video providers.
VIDEO_PROVIDER=local-ffmpeg
VIDEO_PROVIDER_API_KEY=
