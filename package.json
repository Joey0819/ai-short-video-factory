{
  "name": "ai-short-video-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3024",
    "build": "tsc -b && vite build",
    "start": "node scripts/start-production.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 3025",
    "api": "node scripts/api-server.mjs",
    "bundle": "node scripts/bundle-episode.mjs",
    "generate": "node scripts/generate-batch.mjs",
    "openai:dry-run": "node scripts/openai-dry-run.mjs",
    "produce": "node scripts/produce-video.mjs",
    "providers": "node scripts/provider-status.mjs",
    "launch:check": "node scripts/launch-preflight.mjs",
    "render": "node scripts/render-mock-video.mjs",
    "packaged": "npm run produce -- --topic \"AI cartoon fruit drama\" --count 5",
    "test:e2e": "playwright test",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.16"
  }
}
